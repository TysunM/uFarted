# --- How the app reaches the internet ---
# tunnel = Cloudflare Tunnel (free, works on a laptop, no open ports)   caddy = server with a public IP
COMPOSE_PROFILES=tunnel
# Cloudflare Zero Trust → Networks → Tunnels → your tunnel → Docker install command → the long token
TUNNEL_TOKEN=

# --- Your address ---
DOMAIN=ufarted.app
PUBLIC_URL=https://ufarted.app

# --- Branding & support (support email is shown in the app and legal pages; app stores require one) ---
APP_NAME=uFarted
SUPPORT_EMAIL=support@ufarted.app

# --- Moderation ---
# Moderators are granted from the CLI: docker compose exec app node server/admin.js admin <username>
# Distinct reports (from accounts older than 24h) before a post is auto-hidden.
REPORT_HIDE_THRESHOLD=3
# Optional: get a phone/Discord ping on every report. Works with https://ntfy.sh/<your-topic> or a Discord webhook URL.
MOD_WEBHOOK_URL=

# --- Tuning (defaults are fine for a laptop or a 2-CPU server) ---
MAX_CLIP_SECONDS=15
FFMPEG_CONCURRENCY=2
BACKUP_KEEP=7
