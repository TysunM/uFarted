# --- Required ---
DOMAIN=toottally.example.com
PUBLIC_URL=https://toottally.example.com

# --- Branding & support (support email is shown in the app and legal pages; app stores require one) ---
APP_NAME=TootTally
SUPPORT_EMAIL=support@example.com

# --- Moderation ---
# Moderators are granted from the CLI: docker compose exec app node server/admin.js admin <username>
# Distinct reports before a post is auto-hidden.
REPORT_HIDE_THRESHOLD=3
# Optional: get a phone/Discord ping on every report. Works with https://ntfy.sh/<your-topic> or a Discord webhook URL.
MOD_WEBHOOK_URL=

# --- Premium via Stripe (leave all three empty to run with every feature free) ---
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
# payment = one-time unlock, subscription = recurring price
STRIPE_MODE=payment
PREMIUM_PRICE_LABEL=$4.99 one-time

# --- Tuning (defaults are fine for a 2-CPU server) ---
MAX_CLIP_SECONDS=15
FFMPEG_CONCURRENCY=2
BACKUP_KEEP=7
