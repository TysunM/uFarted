{
  "name": "ufart",
  "version": "1.0.0",
  "private": true,
  "description": "Fun, science-backed gas tracker: log farts & burps, record them, share with the community.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "NODE_ENV=development node --watch server/index.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "e2e": "node test/e2e/run.js",
    "admin": "node server/admin.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/helmet": "^13.1.2",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.6",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.5",
    "obscenity": "^0.4.6"
  },
  "devDependencies": {
    "playwright-core": "^1.64.0"
  }
}
