{
  "name": "{{APP}} — gas tracker",
  "short_name": "{{APP}}",
  "description": "Log farts & burps, record them, and track your gut health. Fun first, science-backed.",
  "start_url": "/#/today",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#fbf7f0",
  "theme_color": "#7c3aed",
  "categories": ["health", "lifestyle", "entertainment"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Log a fart", "url": "/#/today?log=fart" },
    { "name": "Log a burp", "url": "/#/today?log=burp" }
  ]
}
